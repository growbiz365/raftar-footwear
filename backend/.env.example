PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/revone?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Comma-separated frontend origins allowed to call the API. Requests with a
# different Origin/Referer are rejected with 403.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://raftarfootwear.com,https://www.raftarfootwear.com
# Shared secret sent as X-App-Key by the frontend. Keep the same value as the
# frontend's VITE_APP_KEY at build time.
API_ACCESS_KEY=raftar-frontend-key-2026